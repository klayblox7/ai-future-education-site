# Set a long, unique password before starting the admin.
ADMIN_PASSWORD=replace-with-a-long-unique-password
PORT=3000
DATA_DIR=./data
# Set to your HTTPS origin when deployed, e.g. https://your-domain.kr
PUBLIC_ORIGIN=
# Set to 1 only behind Render's trusted ingress. Leave 0 locally.
TRUST_PROXY_HOPS=0
